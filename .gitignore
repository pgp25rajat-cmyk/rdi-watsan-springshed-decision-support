# Operating-system and Office temporary files
desktop.ini
Thumbs.db
~$*

# Reproducible artefacts; retain the inputs and generation scripts instead
data/02_processed/*
!data/02_processed/.gitkeep
# Small per-spring feature tables are committed so the team can open them without rebuilding
!data/02_processed/spring_features/
!data/02_processed/lineaments/
!data/02_processed/spring_master/
!data/02_processed/field_visit/
# ERA5 winter snow grid and snow-height curve (a few KB; the raw ERA5 files are large and not kept)
!data/02_processed/climate/
data/03_outputs/*
!data/03_outputs/.gitkeep
# Module A results are small text tables and reports, committed so the team can open them
!data/03_outputs/module_a/

# Secrets and local application state
.env
.streamlit/secrets.toml
*.qgz~

# Python bytecode
__pycache__/

# Downloaded public layers (DEM, WorldCover, HWSD); rebuilt by scripts/build_spring_features.py
.layer_cache/
# Layers downloaded by hand (CartoDEM, IMD, SoilGrids); licences do not allow redistribution in all cases
.local_layers/

# Node packages for the web page (app/dist/ is committed so the laptop needs no Node.js)
app/node_modules/

# Deployment artefacts can contain licensed geographic data; never commit them.
deploy/artifacts/
.deployment-benchmark/
